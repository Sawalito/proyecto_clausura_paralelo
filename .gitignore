# --- Ejecutables y Binarios ---
# Ignora archivos sin extensión (comúnmente binarios de C++ en Linux)
*
!*/
!*.*
!Makefile
!CMakeLists.txt
!LICENSE
!README

# Extensiones de objetos y bibliotecas
*.o
*.obj
*.out
*.so
*.a
*.lib
*.dll
*.exe
*.dylib
*.gch
*.pch
*.d

# Core dumps y archivos de depuración
core
core.*
*.stackdump
vgcore.*

# --- Resultados y Datos ---
# Ignora específicamente los archivos de datos generados
*.csv
*.dat
*.log
*.results
*.tsv

# --- Cache del Proyecto ---
.bow_cache/
*.cache

# --- Directorios de Compilación ---
build/
bin/
dist/
obj/
.cache/

# --- CUDA & Paralelo ---
# Archivos temporales de compilación de NVIDIA
*.i
*.ii
*.gpu
*.ptx
*.cubin
*.fatbin

# Archivos temporales de MPI
*.btr

# --- Entorno de Desarrollo ---
.vscode/
.idea/
.claude/
*.swp
*.swo
*.swn
*~
.*.kate-swp

# --- Archivos de Sistema ---
.DS_Store
Thumbs.db
desktop.ini

# --- Backups y temporales ---
*.bak
*.tmp
*.orig
*.rej
